# Reddit (required for reddit_* tools). An Apify token -- Reddit closed
# self-service OAuth app registration and blocks unauthenticated scraping, so
# this goes through the trudax/reddit-scraper-lite actor on Apify instead.
# Sign up at https://apify.com (no card) and get a token from Settings >
# Integrations. Can be the same value as APIFY_TOKEN below, or a separate
# account's token if you want Reddit and Twitter usage billed separately.
REDDIT_API_KEY=

# YouTube (required for youtube_* tools). Create a key in Google Cloud Console
# with the "YouTube Data API v3" enabled. Free: 10,000 quota units/day.
YOUTUBE_API_KEY=

# Twitter/X (required for twitter_* tools). Sign up at https://twitterapi.io
# (email only, no card) for a free trial credit, then get your key from the
# dashboard.
TWITTERAPI_IO_KEY=

# Twitter/X fallback (optional). If TwitterAPI.io fails, twitter_* tools retry
# via the apidojo/tweet-scraper actor on Apify. Sign up at https://apify.com
# (no card) for $5/month in free platform credits, then get your token from
# Settings > Integrations.
APIFY_TOKEN=

# Only used when hosting over HTTP (see README "Hosting"). Any long random
# string -- every request must send it back as the X-MCP-Auth header, so
# random internet traffic can't spend your API quota/credits. Not needed for
# local stdio use.
MCP_SERVER_SECRET=
