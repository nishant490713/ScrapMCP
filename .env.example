# Reddit (optional). Without these, the server falls back to Reddit's public
# read-only .json endpoints (works, but stricter unofficial rate limits).
# Create an app at https://www.reddit.com/prefs/apps (note: new app registration
# currently requires manual approval from Reddit).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pain-point-mcp/0.1 (by u/your_username)

# YouTube (required for youtube_* tools). Create a key in Google Cloud Console
# with the "YouTube Data API v3" enabled. Free: 10,000 quota units/day.
YOUTUBE_API_KEY=

# Twitter/X (required for twitter_* tools). Sign up at https://twitterapi.io
# (email only, no card) for a free trial credit, then get your key from the
# dashboard.
TWITTERAPI_IO_KEY=
